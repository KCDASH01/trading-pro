{
  "name": "trading-signal-pro",
  "private": true,
  "version": "0.0.0",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:extension": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "npm run build:extension && npm run build:server",
    "build:extension": "tsc -b && vite build",
    "build:server": "tsup server/main.ts --format esm --platform node --out-dir server-dist --clean",
    "start:server": "node server-dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint src server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/websockets": "^11.1.9",
    "@prisma/client": "6.19.0",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prisma": "6.19.0",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.0.4"
  }
}
